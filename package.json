{
    "name": "capstone",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "artisan": "cd server && php artisan serve --host=0.0.0.0 --port=8000",
        "reverb": "cd server && php artisan reverb:start",
        "schedule": "cd server && php artisan schedule:work",
        "queue": "cd server && php artisan queue:work",
        "client": "pnpm --prefix client exec nuxt dev --host 0.0.0.0 --port 3000 --strictPort",
        "ssl-proxy": "node --disable-warning=DEP0060 node_modules/local-ssl-proxy/build/main.js --hostname 127.0.0.1 --cert client/certs/dev.pem --key client/certs/dev-key.pem",
        "api-https": "wait-on tcp:127.0.0.1:8000 && npm run ssl-proxy -- --source 8443 --target 8000",
        "reverb-wss": "wait-on tcp:127.0.0.1:8080 && npm run ssl-proxy -- --source 9443 --target 8080",
        "env": "node scripts/sync-env.mjs",
        "db": "node scripts/db.mjs",
        "db:fresh": "node scripts/db.mjs --fresh",
        "db:remote": "node scripts/db.mjs --remote",
        "stack": "concurrently \"npm run artisan\" \"npm run api-https\" \"npm run reverb\" \"npm run reverb-wss\" \"npm run schedule\" \"npm run client\" ",
        "dev": "concurrently \"npm run artisan\" \"npm run reverb\" \"npm run schedule\" \"npm run client\" ",
        "dev:https": "npm run env && npm run db:remote && npm run stack",
        "dev:db": "npm run env && npm run db && npm run stack"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.28.2",
    "devDependencies": {
        "concurrently": "^10.0.0",
        "local-ssl-proxy": "^2.0.5",
        "wait-on": "^9.5.1"
    }
}
