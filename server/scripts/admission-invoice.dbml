// Paste into https://dbdiagram.io (Import / New diagram)

Table patients {
  patient_id bigint [pk, increment]
  first_name varchar
  last_name varchar
}

Table patient_diagnosis {
  patient_diagnosis_id bigint [pk, increment]
  patient_id bigint [not null, ref: > patients.patient_id]
  diagnosis varchar
  diagnosis_date date
  diagnosis_notes text
  diagnosis_file varchar
}

Table diagnosis_cases {
  diagnosis_case_id bigint [pk, increment]
  branch_id bigint [not null]
  title varchar [not null]
  description text
  price decimal(10,2) [not null, note: 'monthly price']
}

Table branch_contracts {
  branch_contract_id bigint [pk, increment]
  accommodation_type varchar
  billing_cycle varchar [note: 'MONTHLY / YEARLY']
  price decimal(10,2)
}

Table patient_admissions {
  patient_admission_id bigint [pk, increment]
  patient_id bigint [not null, ref: > patients.patient_id]
  bed_id bigint [not null]
  status enum [note: 'waiting, admitted, discharged, cancelled']
  note varchar
  admitted_at timestamp
  discharged_at timestamp
}

Table admission_periods {
  admission_period_id bigint [pk, increment]
  patient_admission_id bigint [not null, ref: > patient_admissions.patient_admission_id]
  branch_contract_id bigint [not null, ref: > branch_contracts.branch_contract_id]
  parent_admission_period_id bigint [ref: > admission_periods.admission_period_id, note: 'accommodation change chain']
  start_date timestamp [not null]
  end_date timestamp [not null]
  status enum [note: 'pending, active, inactive, cancelled']
  reason enum [note: 'admitted, extended, accommodation_change']
  note varchar
}

Table invoices {
  invoice_id bigint [pk, increment]
  invoice_code varchar [unique, not null]
  total_amount decimal(10,2) [not null]
  status enum [note: 'unpaid, partially_paid, paid, void, written_off']
  branch_id bigint [not null]
  created_at timestamp
}

// Stay (room) invoice lines, one invoice can cover several periods
Table invoice_admission {
  invoice_admission_id bigint [pk, increment]
  admission_period_id bigint [not null, ref: > admission_periods.admission_period_id]
  invoice_id bigint [not null, ref: > invoices.invoice_id]
  price decimal(10,2) [not null]
  description varchar
}

// A charge for diagnosis cases, billed on an invoice of its own
Table admission_charge_diagnosis {
  admission_charge_diagnosis_id bigint [pk, increment]
  admission_period_id bigint [not null, ref: > admission_periods.admission_period_id]
  invoice_id bigint [not null, ref: > invoices.invoice_id]
  amount decimal(10,2) [not null, note: 'billed on the invoice: monthly x1, or x12 on a yearly period']
}

// The diagnoses under a charge
Table admission_diagnosis {
  admission_diagnosis_id bigint [pk, increment]
  admission_charge_diagnosis_id bigint [not null, ref: > admission_charge_diagnosis.admission_charge_diagnosis_id]
  patient_diagnosis_id bigint [not null, ref: > patient_diagnosis.patient_diagnosis_id]
  diagnosis_case_id bigint [ref: > diagnosis_cases.diagnosis_case_id]
  description varchar
  amount decimal(10,2) [not null, note: 'billed on the invoice: monthly x1, or x12 on a yearly period']
}

// Charges added to an admitted patient, linked to the patient
Table additional_charges {
  additional_charge_id bigint [pk, increment]
  patient_id bigint [not null, ref: > patients.patient_id]
  invoice_id bigint [not null, ref: > invoices.invoice_id]
  type enum [note: 'medication, supplies, additional_charges']
  description varchar [not null]
  amount decimal(10,2) [not null]
}
